[% TRY %]
    [% PROCESS "$PLUGIN_DIR/i18n/${LANG}.inc" %]
[% CATCH %]
    [% PROCESS "$PLUGIN_DIR/i18n/default.inc" %]
[% END %]
[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]
<title>[% T.configure_1 %]</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="plugins_holdprioritizer_configure" class="plugins">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">[% T.configure_2 %]</a> &rsaquo;
    <a href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.configure_3 %]</a> &rsaquo;
    [% T.configure_4 %]
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-12 col-xl-10">
            <main>
                [% INCLUDE 'messages.inc' %]

                <h1>[% T.configure_5 %]</h1>

                [% IF saved %]
                    <div class="alert alert-success">[% T.configure_6 %]</div>
                [% END %]

                [% FOREACH message IN messages %]
                    <div class="alert alert-[% message.alert_class | html %]">[% message.text | html %]</div>
                [% END %]

                <form method="post" class="page-section">
                    <input type="hidden" name="class" value="[% CLASS | html %]" />
                    <input type="hidden" name="method" value="[% METHOD | html %]" />
                    <input type="hidden" name="save" value="1" />
                    [% INCLUDE 'csrf-token.inc' %]

                    <fieldset class="rows">
                        <legend>[% T.configure_7 %]</legend>
                        <ol>
                            <li>
                                <label for="LocalHoldsPriority">[% T.configure_8 %]</label>
                                <select name="LocalHoldsPriority" id="LocalHoldsPriority">
                                    <option value="None" [% IF LocalHoldsPriority == 'None' %]selected[% END %]>[% T.configure_9 %]</option>
                                    <option value="GiveLibrary" [% IF LocalHoldsPriority == 'GiveLibrary' %]selected[% END %]>[% T.configure_10 %]</option>
                                    <option value="GiveLibraryAndGroup" [% IF LocalHoldsPriority == 'GiveLibraryAndGroup' %]selected[% END %]>[% T.configure_11 %]</option>
                                    <option value="GiveLibraryGroup" [% IF LocalHoldsPriority == 'GiveLibraryGroup' %]selected[% END %]>[% T.configure_12 %]</option>
                                </select>
                                <div class="hint">[% T.configure_13 %]</div>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityPatronControl">[% T.configure_14 %]</label>
                                <select name="LocalHoldsPriorityPatronControl" id="LocalHoldsPriorityPatronControl">
                                    <option value="PickupLibrary" [% IF LocalHoldsPriorityPatronControl == 'PickupLibrary' %]selected[% END %]>[% T.configure_15 %]</option>
                                    <option value="HomeLibrary" [% IF LocalHoldsPriorityPatronControl == 'HomeLibrary' %]selected[% END %]>[% T.configure_16 %]</option>
                                </select>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityItemControl">[% T.configure_17 %]</label>
                                <select name="LocalHoldsPriorityItemControl" id="LocalHoldsPriorityItemControl">
                                    <option value="homebranch" [% IF LocalHoldsPriorityItemControl == 'homebranch' %]selected[% END %]>[% T.configure_18 %]</option>
                                    <option value="holdingbranch" [% IF LocalHoldsPriorityItemControl == 'holdingbranch' %]selected[% END %]>[% T.configure_19 %]</option>
                                </select>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityMaxHolds">[% T.configure_20 %]</label>
                                <input type="text" name="LocalHoldsPriorityMaxHolds" id="LocalHoldsPriorityMaxHolds" value="[% LocalHoldsPriorityMaxHolds | html %]" />
                                <div class="hint">[% T.configure_21 %]</div>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityMinItems">[% T.configure_22 %]</label>
                                <input type="text" name="LocalHoldsPriorityMinItems" id="LocalHoldsPriorityMinItems" value="[% LocalHoldsPriorityMinItems | html %]" />
                                <div class="hint">[% T.configure_23 %]</div>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityHoldsPerItemThreshold">[% T.configure_24 %]</label>
                                <input type="text" name="LocalHoldsPriorityHoldsPerItemThreshold" id="LocalHoldsPriorityHoldsPerItemThreshold" value="[% LocalHoldsPriorityHoldsPerItemThreshold | html %]" />
                                <div class="hint">[% T.configure_25 %]</div>
                            </li>
                            <li>
                                <label for="LocalHoldsPriorityFulfillmentSkips">[% T.configure_26 %]</label>
                                <input type="text" name="LocalHoldsPriorityFulfillmentSkips" id="LocalHoldsPriorityFulfillmentSkips" value="[% LocalHoldsPriorityFulfillmentSkips | html %]" />
                                <div class="hint">[% T.configure_27 %]</div>
                            </li>
                            <li>
                                <label for="TakeOverCoreLocalHoldsPriority">[% T.configure_28 %]</label>
                                <input type="checkbox" name="TakeOverCoreLocalHoldsPriority" id="TakeOverCoreLocalHoldsPriority" value="1" [% IF TakeOverCoreLocalHoldsPriority %]checked="checked"[% END %] />
                                <div class="hint">[% T.configure_29 %]</div>
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="action">
                        <input type="submit" class="btn btn-primary" value="[% T.configure_30 %]" />
                        <a class="btn btn-default" href="/cgi-bin/koha/plugins/plugins-home.pl">[% T.configure_31 %]</a>
                    </fieldset>
                </form>
            </main>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]